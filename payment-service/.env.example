# Copy to .env (gitignored) and fill in. Start with: node --env-file=.env server.mjs
BREEZ_NETWORK=regtest
# 12 or 24 words. This is the cpay platform wallet: whoever holds it holds every creator's unwithdrawn money.
BREEZ_MNEMONIC=
# Required on mainnet only. Regtest needs no key.
BREEZ_API_KEY=
BREEZ_DATA_DIR=./.data
# Postgres connection string for the Supabase database (a role that can run settle_breez_payment).
DATABASE_URL=
# Shared with the create-invoice and health edge functions (Supabase secret of the same name).
PAYMENT_SERVICE_SECRET=
PORT=8080
CATCH_UP_INTERVAL_SECS=300
