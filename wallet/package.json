{
  "name": "cpay-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CPAY Wallet: optional standalone non-custodial Lightning wallet (installable web app). Separate from the CPAY website and its ledger.",
  "scripts": {
    "build": "node build.mjs",
    "build:staging": "WALLET_STAGE=staging WALLET_NETWORK=regtest WALLET_LINK=off node build.mjs",
    "serve": "node serve.mjs"
  },
  "dependencies": {
    "@breeztech/breez-sdk-spark": "0.26.0",
    "@supabase/supabase-js": "2.117.3",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "jsqr": "1.4.0"
  }
}
