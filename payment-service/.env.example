# Copy to .env (gitignored) and fill in. Start with: node --env-file=.env server.mjs
# Every variable is described in docs/ENV_VARS.md.
BREEZ_NETWORK=regtest
# The cpay platform wallet words (12 or 24). Whoever holds them holds every
# creator's unwithdrawn money. Prefer a file readable only by the service user.
# Set exactly one of BREEZ_MNEMONIC_FILE or BREEZ_MNEMONIC.
BREEZ_MNEMONIC_FILE=
BREEZ_MNEMONIC=
# Required on mainnet only. Regtest needs no key.
BREEZ_API_KEY=
# Wallet cache. Keep it on a persistent disk.
BREEZ_DATA_DIR=./.data
# Postgres connection string for the Supabase database (a role that can run settle_breez_payment).
DATABASE_URL=
# At least 32 characters. Same value as the PAYMENT_SERVICE_SECRET edge function secret.
PAYMENT_SERVICE_SECRET=
PORT=8080
CATCH_UP_INTERVAL_SECS=300
# How long a stop signal waits for sends in flight before disconnecting anyway.
SHUTDOWN_TIMEOUT_SECS=90
